diff --git a/steel-core/src/command/builtins/forceload.rs b/steel-core/src/command/builtins/forceload.rs
new file mode 100644
index 000000000..e6ebf1fae
--- /dev/null
+++ b/steel-core/src/command/builtins/forceload.rs
@@ -0,0 +1,71 @@
+//! Forced chunks: `/forceload add <from> [<to>]` and `/forceload remove <from> [<to>]`, which
+//! keep every chunk in the square between two columns loaded and generated in full until they
+//! are removed again.
+
+use steel_utils::{ChunkPos, Identifier};
+use text_components::TextComponent;
+
+use super::super::{
+    brigadier::{CommandNodeBuilder, CommandSyntaxError},
+    execution::{
+        CommandSource, SteelArgumentType, SteelCommandContext, SteelCommandRuntime, argument,
+        literal,
+    },
+    registration::CommandRegistration,
+};
+
+/// Vanilla's limit on the chunks one command changes.
+const MAX_CHUNKS: i64 = 256;
+
+pub(super) fn registration() -> CommandRegistration<CommandSource> {
+    CommandRegistration::new(Identifier::vanilla_static("forceload"), |_| command())
+}
+
+fn command() -> CommandNodeBuilder<CommandSource, SteelCommandRuntime> {
+    literal("forceload")
+        .then(literal("add").then(
+            argument("from", SteelArgumentType::vec2(false))
+                .executes(|context| change(context, "from", true))
+                .then(argument("to", SteelArgumentType::vec2(false)).executes(|context| change(context, "to", true))),
+        ))
+        .then(literal("remove").then(
+            argument("from", SteelArgumentType::vec2(false))
+                .executes(|context| change(context, "from", false))
+                .then(argument("to", SteelArgumentType::vec2(false)).executes(|context| change(context, "to", false))),
+        ))
+}
+
+/// The chunk holding a column given in block coordinates.
+fn chunk_of(context: &SteelCommandContext<CommandSource>, name: &str) -> Result<(i32, i32), CommandSyntaxError> {
+    let position = context.coordinates(name)?.position(context.source());
+    Ok(((position.x.floor() as i32) >> 4, (position.z.floor() as i32) >> 4))
+}
+
+fn change(context: &SteelCommandContext<CommandSource>, to: &str, add: bool) -> Result<i32, CommandSyntaxError> {
+    let from = chunk_of(context, "from")?;
+    let to = chunk_of(context, to)?;
+    let (min_x, max_x) = (from.0.min(to.0), from.0.max(to.0));
+    let (min_z, max_z) = (from.1.min(to.1), from.1.max(to.1));
+    let count = i64::from(max_x - min_x + 1) * i64::from(max_z - min_z + 1);
+    if count > MAX_CHUNKS {
+        return Err(CommandSyntaxError::dynamic(TextComponent::plain(format!(
+            "Too many chunks in the specified area (maximum {MAX_CHUNKS}, specified {count})"
+        ))));
+    }
+    let chunk_map = &context.source().world().chunk_map;
+    for x in min_x..=max_x {
+        for z in min_z..=max_z {
+            if add {
+                chunk_map.add_forced_ticket(ChunkPos::new(x, z));
+            } else {
+                chunk_map.remove_forced_ticket(ChunkPos::new(x, z));
+            }
+        }
+    }
+    let verb = if add { "Marked" } else { "Unmarked" };
+    let message = TextComponent::plain(format!(
+        "{verb} {count} chunks from [{min_x}, {min_z}] to [{max_x}, {max_z}] to be force loaded"
+    ));
+    context.source().send_success(&message, true);
+    Ok(count as i32)
+}
